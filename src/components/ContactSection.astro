---
import { siteConfig, getWhatsAppLink, url } from '../data/site';
---

<section
  class="py-space-2xl bg-background border-y border-outline-variant/30"
  id="contacto"
  aria-labelledby="contact-title"
>
  <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin">
    <div class="grid grid-cols-1 gap-space-xl">

      <!-- Canales Directos e Información de Guardia -->
      <div class="flex flex-col justify-between gap-space-lg w-full">
        <div class="contact-panel relative overflow-hidden bg-primary-container text-on-primary rounded-2xl p-6 sm:p-8 lg:p-10 border border-primary-container shadow-lg shadow-primary/10 flex flex-col gap-8">
          <div class="max-w-2xl">
            <span class="inline-flex items-center px-3 py-1 text-xs font-technical-code font-bold bg-secondary-container text-white rounded-full tracking-wider">
              CANALES DIRECTOS
            </span>
            <h2 id="contact-title" class="font-headline-md text-headline-md text-white mt-4">
              Atención Inmediata
            </h2>
            <p class="font-body-sm text-body-sm text-on-primary-container mt-2">
              Coordinamos la atención de requerimientos de empresas, comercios y particulares.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3 md:gap-4">
            <!-- Teléfono -->
            <a class="contact-channel touch-target flex items-center gap-4 p-4 rounded-xl border border-white/10 bg-white/[0.06] hover:bg-white/[0.12] hover:border-white/25" href={`tel:${siteConfig.telephoneRaw}`}>
              <span class="contact-channel-icon" aria-hidden="true"><span class="material-symbols-outlined text-2xl" aria-hidden="true">call</span></span>
              <div class="min-w-0">
                <span class="font-technical-code text-xs text-surface-variant block uppercase font-bold">Teléfono</span>
                <span class="font-headline-sm text-headline-sm text-white font-semibold">{siteConfig.telephoneDisplay}</span>
              </div>
            </a>

            <!-- WhatsApp -->
            <a class="contact-channel cta-button-whatsapp flex gap-4 p-4 rounded-xl items-center border" href={getWhatsAppLink("Hola SIBJ, solicito asistencia técnica inmediata")} rel="noopener noreferrer" target="_blank">
              <span class="contact-channel-icon contact-channel-icon--whatsapp" aria-hidden="true"><img src={url('/assets/whatsapp.png')} alt="" class="w-6 h-6" width="24" height="24" /></span>
              <div class="min-w-0">
                <span class="font-technical-code text-xs text-white block uppercase font-bold">Canal Directo</span>
                <span class="font-headline-sm text-headline-sm text-white font-semibold">WhatsApp</span>
              </div>
            </a>

            <!-- Email -->
            <a class="contact-channel touch-target md:col-span-2 xl:col-span-1 flex items-center gap-4 p-4 rounded-xl border border-white/10 bg-white/[0.06] hover:bg-white/[0.12] hover:border-white/25" href={`mailto:${siteConfig.email}`}>
              <span class="contact-channel-icon" aria-hidden="true"><span class="material-symbols-outlined text-2xl" aria-hidden="true">mail</span></span>
              <div class="min-w-0">
                <span class="font-technical-code text-xs text-surface-variant block uppercase font-bold">Email Institucional</span>
                <span class="font-body-md text-body-md text-white font-semibold break-words">{siteConfig.email}</span>
              </div>
            </a>
          </div>

          <div class="pt-5 border-t border-white/15 space-y-2">
            <div class="flex items-center gap-2 text-surface-variant text-sm">
              <span class="material-symbols-outlined text-base text-secondary-fixed-dim" aria-hidden="true">location_on</span>
              <span class="font-body-sm text-body-sm">Neuquén, Río Negro</span>
            </div>
          </div>
        </div>

        <!-- Quality assurance note -->
        <div class="p-5 sm:p-6 rounded-2xl bg-surface-container-lowest border border-outline-variant/60 shadow-sm flex items-center gap-4">
          <span class="ui-icon-tile inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-surface-container-high text-primary" aria-hidden="true"><span class="material-symbols-outlined text-2xl" aria-hidden="true">verified_user</span></span>
          <div>
            <h3 class="font-headline-sm text-headline-sm text-primary text-sm font-bold">Compromiso Operativo y Comercial</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant text-xs mt-0.5">Acuerdos de servicio claros, facturación formal y cumplimiento responsable en cada intervención.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
