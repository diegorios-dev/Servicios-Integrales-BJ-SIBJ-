---
interface Props {
  etiqueta: string;
  texto: string;
  cargo: string;
  empresa: string;
  rubro: string;
  imagen: string;
  imagenAlt: string;
  esTrabajo?: boolean;
}

const { etiqueta, texto, cargo, empresa, rubro, imagen, imagenAlt, esTrabajo = false } = Astro.props;
const QuoteTag = esTrabajo ? 'div' : 'blockquote';
---

<article class="ui-card testimonial-card reveal group bg-surface-container-lowest border border-outline-variant/60 rounded-2xl overflow-hidden flex flex-col justify-between">
  <div class="relative h-56 sm:h-64 w-full overflow-hidden bg-surface-container-low">
    <img src={imagen} alt={imagenAlt} class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-[1.04]" width="800" height="520" loading="lazy" decoding="async" />
    <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-primary/45 to-transparent" aria-hidden="true"></div>
    <div class="absolute top-4 left-4">
      <span class="font-technical-code text-xs px-3 py-1.5 rounded-full border border-white/20 bg-primary-container/95 text-white font-bold shadow-lg">{rubro}</span>
    </div>
  </div>
  <div class="p-6 sm:p-7 flex flex-col flex-1 justify-between gap-5">
    <QuoteTag class="m-0">
      <p class:list={["testimonial-quote font-body-md text-body-md text-on-surface leading-relaxed", { italic: !esTrabajo }]}>{texto}</p>
    </QuoteTag>
    <div class="pt-4 border-t border-outline-variant/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      {esTrabajo ? (
        <span class="font-technical-code text-xs text-on-surface-variant">{etiqueta}</span>
      ) : (
        <div class="flex flex-col">
          <span class="font-headline-sm text-sm font-bold text-primary">{cargo}</span>
          <span class="font-technical-code text-xs text-on-surface-variant">{empresa}, {rubro}</span>
        </div>
      )}
      {!esTrabajo && <span class="font-technical-code text-xs px-3 py-1 rounded-full border border-outline-variant/50 bg-surface-container-low text-primary font-semibold self-start sm:self-center shrink-0">{etiqueta}</span>}
    </div>
  </div>
</article>