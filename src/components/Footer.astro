---
import { siteConfig } from '../data/site';
---

<footer class="bg-primary relative">
  <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin py-space-2xl w-full flex flex-col gap-space-xl">
    
    <!-- Top Row: Logo & Navigation Cluster -->
    <div class="flex flex-col md:flex-row justify-between items-start gap-space-xl w-full">
      <div class="flex flex-col gap-space-md max-w-lg">
        <div class="flex items-center gap-3">
          <img src="/assets/logo1.png" alt="SIBJ Logo" class="h-12 w-12 object-contain rounded-lg brightness-110" width="48" height="48" />
          <span class="font-headline-lg text-headline-lg font-extrabold text-surface-container-lowest tracking-tight">{siteConfig.name}</span>
        </div>
        <p class="font-body-sm text-body-sm text-on-primary-container leading-relaxed">
          Servicios Integrales BJ (SIBJ). Mantenimiento técnico preventivo y correctivo, obras y climatización de infraestructura edilicia e industrial de alto rendimiento.
        </p>
      </div>

      <div class="flex flex-col gap-2 md:items-end md:text-right">
        <h3 class="font-headline-sm text-headline-sm text-surface-container-lowest mb-2">Servicios Principales</h3>
        <a class="text-on-primary-container font-body-sm text-body-sm hover:underline hover:text-surface-container-lowest transition-colors" href="/climatizacion-refrigeracion-neuquen">Climatización & Refrigeración</a>
        <a class="text-on-primary-container font-body-sm text-body-sm hover:underline hover:text-surface-container-lowest transition-colors" href="/mantenimiento-edilicio-neuquen">Mantenimiento Edilicio</a>
        <a class="text-on-primary-container font-body-sm text-body-sm hover:underline hover:text-surface-container-lowest transition-colors" href="/electricidad-tableros-neuquen">Electricidad & Tableros</a>
        <a class="text-on-primary-container font-body-sm text-body-sm hover:underline hover:text-surface-container-lowest transition-colors" href="/obras-trabajos-civiles-neuquen">Obras & Trabajos Civiles</a>
      </div>
    </div>

    <!-- Separation & Copyright text -->
    <div class="pt-space-md border-t border-outline/30 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="font-body-sm text-body-sm text-on-primary-container">© 2026 Servicios Integrales BJ (SIBJ). Todos los derechos reservados. Mantenimiento técnico e ingeniería edilicia industrial y comercial.</p>
      <span class="font-technical-code text-technical-code text-on-primary-container text-xs">Neuquén, Argentina</span>
    </div>

  </div>
</footer>