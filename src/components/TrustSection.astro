---
import { url } from '../data/site';

const trustItems = [
  ['verified_user', 'Trabajo planificado', 'Intervenciones coordinadas para locales, comercios y empresas.'],
  ['engineering', 'Equipo técnico especializado', 'Experiencia en climatización, mantenimiento edilicio, electricidad y obras.'],
  ['location_on', 'Cobertura local', 'Atención en Neuquén capital.'],
];

const workImages = [
  ['/assets/mostaza.webp', 'Mantenimiento de climatización en sucursal gastronómica de Neuquén'],
  ['/assets/instalacion.png', 'Instalación de sistema sanitario y tratamiento de aguas residuales'],
];
---

<section class="py-space-2xl bg-surface-container-low border-y border-outline-variant/30" id="confianza" aria-labelledby="trust-title">
  <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin">
    <div class="max-w-3xl mb-space-xl">
      <p class="font-technical-code text-technical-code text-secondary-container font-bold uppercase tracking-wider block mb-1">Confianza y respaldo operativo</p>
      <h2 id="trust-title" class="font-headline-xl text-headline-xl text-primary">Clientes, seguridad y trabajos realizados</h2>
      <p class="font-body-md text-body-md  mt-2">Una forma de trabajo orientada a la continuidad operativa de locales, comercios y empresas.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-space-lg mb-space-xl">
      {trustItems.map(([icon, title, description]) => (
        <article class="reveal bg-surface-container-lowest border border-outline-variant/60 rounded-xl p-6">
          <span class="material-symbols-outlined text-secondary-container text-3xl mb-4" aria-hidden="true">{icon}</span>
          <h3 class="font-headline-sm text-headline-sm text-primary mb-2">{title}</h3>
          <p class="font-body-sm text-body-sm text-on-surface-variant">{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
