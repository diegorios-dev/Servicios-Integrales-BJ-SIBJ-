---
import { url } from '../data/site';

const trustItems = [
  ['verified_user', 'Trabajo planificado', 'Intervenciones coordinadas para empresas, comercios y particulares.'],
  ['engineering', 'Equipo técnico especializado', 'Experiencia en climatización, mantenimiento edilicio, electricidad y obras.'],
  ['location_on', 'Cobertura local', 'Atención en Neuquén y Río Negro.'],
];

const workImages = [
  ['/assets/mostaza.webp', 'Mantenimiento de climatización en sucursal gastronómica de Neuquén'],
  ['/assets/instalacion.png', 'Instalación de sistema sanitario y tratamiento de aguas residuales'],
];
---

<section class="py-space-2xl bg-surface-container border-y border-outline-variant/40" id="confianza" aria-labelledby="trust-title">
  <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin">
    <div class="section-intro max-w-3xl mb-space-xl">
      <p class="font-technical-code text-technical-code text-secondary-container font-extrabold uppercase tracking-wider block mb-2">Confianza y respaldo operativo</p>
      <h2 id="trust-title" class="font-headline-xl text-headline-xl text-primary">Clientes, seguridad y trabajos realizados</h2>
      <p class="font-body-md text-body-md text-on-surface-variant mt-3">Una forma de trabajo orientada a resolver las necesidades de empresas, comercios y particulares.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-space-lg mb-space-xl">
      {trustItems.map(([icon, title, description]) => (
        <article class="reveal group bg-surface-container-lowest border border-outline-variant/60 rounded-2xl p-6 sm:p-7">
          <span class="icon-tile mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl" aria-hidden="true"><span class="material-symbols-outlined shrink-0 text-2xl" aria-hidden="true">{icon}</span></span>
          <h3 class="font-headline-sm text-headline-sm text-primary mb-2">{title}</h3>
          <p class="font-body-sm text-body-sm text-on-surface-variant">{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
