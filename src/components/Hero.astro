---
import { getWhatsAppLink, url } from '../data/site';
---

<section class="hero-section relative overflow-hidden pt-10 pb-12 md:pt-14 md:pb-16 lg:pt-16 lg:pb-20 bg-surface-bright" id="inicio" aria-labelledby="hero-title">
  <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      {/* Columna de Contenido / Texto */}
      <div class="lg:col-span-7 flex flex-col items-start gap-5 sm:gap-6">
        
        {/* Etiqueta superior */}
        <div class="hero-reveal hero-eyebrow">
          <span class="material-symbols-outlined" aria-hidden="true">home_repair_service</span>
          <span>Edilicio · Obras · Reformas</span>
        </div>

        {/* Título Principal H1 */}
        <h1 id="hero-title" class="hero-reveal max-w-3xl text-balance text-3xl sm:text-4xl lg:text-5xl font-extrabold text-primary tracking-tight leading-[1.08]">
          Mantenimiento integral para empresas, comercios y particulares <span class="text-accent">en Neuquén</span>
        </h1>

        {/* Párrafo descriptivo */}
        <p class="hero-reveal text-base sm:text-lg text-on-surface-variant max-w-xl leading-relaxed">
          Ofrecemos mantenimiento edilicio preventivo y correctivo, obras civiles y reformas, además de climatización y electricidad, con soluciones adaptadas a cada necesidad.
        </p>

        <div class="hero-reveal flex flex-col sm:flex-row gap-3 w-full sm:w-auto pt-2">
          <a class="cta-button cta-button-whatsapp inline-flex justify-center items-center gap-2.5 w-full sm:w-auto px-7 py-3.5 rounded-xl text-base font-bold border" href={getWhatsAppLink("Hola SIBJ, requiero asistencia técnica")} rel="noopener noreferrer" target="_blank">
            <img src={url('/assets/whatsapp.png')} alt="" aria-hidden="true" class="w-5 h-5" width="20" height="20" />
            <span>Contactanos por WhatsApp</span>
          </a>
        </div>

        {/* Grilla inferior de características (Corregida de 4 a 3 columnas exactas) */}
        <div class="hero-highlights grid grid-cols-1 sm:grid-cols-3 items-stretch divide-y sm:divide-y-0 sm:divide-x divide-outline-variant/50 gap-0 pt-5 border-t border-outline-variant/40 w-full mt-2">
          <div class="flex min-h-12 items-center gap-2.5 py-3 sm:py-0 sm:px-4 first:pl-0">
            <span class="material-symbols-outlined text-secondary-container text-xl" aria-hidden="true">verified</span>
            <span class="text-xs sm:text-sm font-bold text-on-surface">Equipo técnico experimentado</span>
          </div>
          <div class="flex min-h-12 items-center gap-2.5 py-3 sm:px-4">
            <span class="material-symbols-outlined text-secondary-container text-xl" aria-hidden="true">engineering</span>
            <span class="text-xs sm:text-sm font-bold text-on-surface">Compromiso de Calidad</span>
          </div>
          <div class="flex min-h-12 items-center gap-2.5 py-3 sm:px-4 sm:pr-0">
            <span class="material-symbols-outlined text-secondary-container text-xl" aria-hidden="true">location_on</span>
            <span class="text-xs sm:text-sm font-bold text-on-surface">Neuquén y Río Negro</span>
          </div>
        </div>

      </div>

      {/* Columna de Imagen (Con altura fluida para móvil y escritorio) */}
      <div class="lg:col-span-5 relative self-center">
        <div class="hero-media relative rounded-2xl overflow-hidden border border-outline-variant/50 bg-surface-container shadow-lg shadow-primary/5">
          <picture>
            <source srcset={url('/assets/hero-comercios.webp')} type="image/webp" />
            <img src={url('/assets/hero-comercios.webp')} alt="Personal de SIBJ realizando mantenimiento para empresas, comercios y particulares" class="w-full h-[280px] sm:h-[380px] lg:h-[460px] object-cover object-center" width="600" height="460" fetchpriority="high" />
          </picture>
        </div>
      </div>

    </div>
  </div>
</section>