---
import { getWhatsAppLink, url } from '../data/site';
---

<section class="marketing-cta cta-v-sunset text-white py-14 md:py-20 full-width" aria-labelledby="cta-title">
  <div class="relative max-w-3xl mx-auto px-margin-mobile md:px-margin flex flex-col items-center gap-8 text-center">
    <div>
      <h2 id="cta-title" class="font-headline-lg text-3xl md:text-4xl font-extrabold tracking-tight text-white">¿Necesitás asistencia técnica ahora?</h2>
      <p class="font-body-md text-white mt-3 mx-auto">Atención ágil para empresas, comercios y particulares.</p>
    </div>
    <a href={getWhatsAppLink("Hola SIBJ, necesito asistencia técnica ahora")} target="_blank" rel="noopener noreferrer" class="cta-btn-dark inline-flex items-center justify-center gap-3 w-full sm:w-auto px-8 py-4 rounded-xl font-label-md font-bold">
      <img src={url('/assets/whatsapp.png')} alt="" aria-hidden="true" class="w-5 h-5" width="20" height="20" />
      <span>Contactanos</span>
      <span class="sr-only">por WhatsApp</span>
    </a>
  </div>
</section>
