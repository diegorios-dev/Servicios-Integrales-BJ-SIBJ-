---
import { siteConfig, getWhatsAppLink } from '../data/site';
---

<section class="bg-[#ea580c] text-white py-space-xl full-width">
  <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin flex flex-col md:flex-row items-center justify-between gap-6">
    <div>
      <h2 class="font-headline-lg text-2xl md:text-3xl font-extrabold tracking-tight text-white">¿Necesitás asistencia técnica ahora?</h2>
      <p class="font-body-md text-white/90 mt-1">Atención ágil para comercios e industrias.</p>
    </div>
    <a href={getWhatsAppLink("Hola SIBJ, necesito asistencia técnica ahora")} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-white text-primary px-6 py-3.5 rounded-xl font-label-md font-bold hover:bg-surface transition-all duration-150 shadow-md shrink-0 focus:outline-none focus:ring-4 focus:ring-white/50">
      <span class="material-symbols-outlined text-2xl text-green-600">chat</span>
      <span>Contactar por WhatsApp</span>
    </a>
  </div>
</section>