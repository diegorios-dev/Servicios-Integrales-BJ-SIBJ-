---
import { siteConfig, getWhatsAppLink, url } from '../data/site';

const currentPath = Astro.url.pathname;
const isCurrent = (path: string) => currentPath === new URL(url(path), Astro.url).pathname;
---

<header class="bg-surface-container-lowest sticky top-0 z-50 shadow-sm w-full">
  <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin flex justify-between items-center h-20 w-full">
    
    <!-- Brand Logo / Product Identifier -->
    <a class="flex items-center gap-space-sm group focus:outline-none focus:ring-2 focus:ring-secondary-container rounded-lg p-1" href={url('/')}>
      <img src={url('/assets/logo1.png')} alt="SIBJ Logo" class="h-10 w-10 object-contain rounded-lg" width="40" height="40" />
      <div class="flex flex-col">
        <span class="font-headline-md text-headline-md tracking-tight font-extrabold text-primary">{siteConfig.name}</span>
        <span class="font-technical-code text-technical-code text-on-surface-variant text-xs -mt-1 hidden sm:block">&nbsp; &nbsp; Mantenimiento Técnico Corporativo</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-space-lg" aria-label="Principal">
      <a class="text-secondary-container border-b-2 border-secondary-container pb-1 font-label-md text-label-md focus:outline-none focus:ring-2 focus:ring-secondary-container" href={url('/')} aria-current={isCurrent('/') ? 'page' : undefined}>Inicio</a>
      
      <!-- Desplegable de Servicios con soporte de teclado y hover -->
      <div class="relative group">
        <div class="inline-flex items-center">
          <a class="text-on-surface-variant font-label-md text-label-md hover:text-secondary-container transition-colors duration-150 inline-flex items-center gap-1 py-2 focus:outline-none focus:ring-2 focus:ring-secondary-container rounded" href={url('/#servicios')}>
            Servicios
          </a>
          <button type="button" class="dropdown-toggle text-on-surface-variant p-2 focus:outline-none focus:ring-2 focus:ring-secondary-container rounded" aria-label="Mostrar servicios" aria-expanded="false" aria-controls="services-menu">
            <span class="material-symbols-outlined text-sm" aria-hidden="true">expand_more</span>
          </button>
        </div>
        <div id="services-menu" class="dropdown-menu absolute left-0 top-full hidden group-hover:block group-focus-within:block bg-surface-container-lowest shadow-lg rounded-xl border border-outline-variant/40 py-2 w-64 z-50">
          <a class="block px-4 py-2 text-sm text-on-surface hover:bg-surface-container-low transition-colors" href={url('/climatizacion-refrigeracion-neuquen')} aria-current={isCurrent('/climatizacion-refrigeracion-neuquen') ? 'page' : undefined}>Climatización y Refrigeración</a>
          <a class="block px-4 py-2 text-sm text-on-surface hover:bg-surface-container-low transition-colors" href={url('/mantenimiento-edilicio-neuquen')} aria-current={isCurrent('/mantenimiento-edilicio-neuquen') ? 'page' : undefined}>Mantenimiento Edilicio</a>
          <a class="block px-4 py-2 text-sm text-on-surface hover:bg-surface-container-low transition-colors" href={url('/electricidad-tableros-neuquen')} aria-current={isCurrent('/electricidad-tableros-neuquen') ? 'page' : undefined}>Electricidad y Tableros</a>
          <a class="block px-4 py-2 text-sm text-on-surface hover:bg-surface-container-low transition-colors" href={url('/obras-trabajos-civiles-neuquen')} aria-current={isCurrent('/obras-trabajos-civiles-neuquen') ? 'page' : undefined}>Obras y Trabajos Civiles</a>
        </div>
      </div>

      <a class="text-on-surface-variant font-label-md text-label-md hover:text-secondary-container transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-secondary-container rounded" href={url('/#contacto')}>Contacto</a>
    </nav>

    <!-- Trailing Action Group -->
    <div class="flex items-center gap-space-md">
      <a class="hidden lg:flex items-center gap-2 font-technical-code text-technical-code text-on-surface-variant hover:text-primary transition-colors focus:outline-none focus:ring-2 focus:ring-secondary-container rounded p-1" href={`tel:${siteConfig.telephoneRaw}`}>
        <span class="material-symbols-outlined text-secondary-container text-base" data-icon="phone" aria-hidden="true">phone</span>
        <span class="font-semibold">{siteConfig.telephoneDisplay}</span>
      </a>
    </div>

  </div>
</header>

<script>
  document.querySelectorAll<HTMLButtonElement>('.dropdown-toggle').forEach((toggle) => {
    const menu = toggle.closest('.group')?.querySelector<HTMLElement>('.dropdown-menu');
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      if (menu) {
        menu.hidden = expanded;
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        toggle.setAttribute('aria-expanded', 'false');
        if (menu) {
          menu.hidden = true;
        }
        toggle.focus();
      }
    });
  });
</script>