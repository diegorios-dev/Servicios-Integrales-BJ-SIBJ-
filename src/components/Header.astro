---
import { siteConfig, getWhatsAppLink, url } from '../data/site';

const currentPath = Astro.url.pathname;
const isCurrent = (path: string) => currentPath === new URL(url(path), Astro.url).pathname;
---

<header class="bg-surface-container-lowest sticky top-0 z-50 shadow-sm w-full">
  <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin flex justify-between items-center h-16 md:h-20 w-full">
    
    <!-- Brand Logo / Product Identifier -->
    <a class="flex items-center gap-space-sm group focus:outline-none focus:ring-2 focus:ring-secondary-container rounded-lg p-1" href={url('/')}>
      <img src={url('/assets/logo1.png')} alt="SIBJ Logo" class="h-9 w-9 md:h-10 md:w-10 object-contain rounded-lg" width="40" height="40" />
      <div class="flex flex-col">
        <span class="font-headline-md text-headline-md tracking-tight font-extrabold text-primary">{siteConfig.name}</span>
        <span class="font-technical-code text-technical-code text-on-surface-variant text-xs -mt-1 hidden sm:block">&nbsp; &nbsp; Mantenimiento Técnico Corporativo</span>
      </div>
    </a>

    <button
      type="button"
      class="mobile-menu-toggle md:hidden touch-target inline-flex items-center justify-center rounded-lg text-primary focus:outline-none focus:ring-2 focus:ring-secondary-container"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      data-mobile-menu-toggle
    >
      <svg class="mobile-menu-icon mobile-menu-icon-open" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg class="mobile-menu-icon mobile-menu-icon-close" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-space-lg" aria-label="Principal">
      <a class="text-secondary-container border-b-2 border-secondary-container pb-1 font-label-md text-label-md focus:outline-none focus:ring-2 focus:ring-secondary-container" href={url('/')} aria-current={isCurrent('/') ? 'page' : undefined}>Inicio</a>
      
      <!-- Desplegable de Servicios con soporte de teclado y hover -->
      <div class="relative group">
        <div class="inline-flex items-center">
          <a class="text-on-surface-variant font-label-md text-label-md hover:text-secondary-container transition-colors duration-150 inline-flex items-center gap-1 py-2 focus:outline-none focus:ring-2 focus:ring-secondary-container rounded" href={url('/#servicios')}>
            Servicios
          </a>
          <button type="button" class="dropdown-toggle touch-target text-on-surface-variant p-2 focus:outline-none focus:ring-2 focus:ring-secondary-container rounded" aria-label="Mostrar servicios" aria-expanded="false" aria-controls="services-menu">
            <span class="material-symbols-outlined text-sm" aria-hidden="true">expand_more</span>
          </button>
        </div>
        <div id="services-menu" class="dropdown-menu absolute left-0 top-full hidden group-hover:block group-focus-within:block bg-surface-container-lowest shadow-lg rounded-xl border border-outline-variant/40 py-2 w-64 z-50">
          <a class="block px-4 py-2 text-sm text-on-surface hover:bg-surface-container-low transition-colors" href={url('/climatizacion-refrigeracion-neuquen')} aria-current={isCurrent('/climatizacion-refrigeracion-neuquen') ? 'page' : undefined}>Climatización y Refrigeración</a>
          <a class="block px-4 py-2 text-sm text-on-surface hover:bg-surface-container-low transition-colors" href={url('/mantenimiento-edilicio-neuquen')} aria-current={isCurrent('/mantenimiento-edilicio-neuquen') ? 'page' : undefined}>Mantenimiento Edilicio</a>
          <a class="block px-4 py-2 text-sm text-on-surface hover:bg-surface-container-low transition-colors" href={url('/electricidad-tableros-neuquen')} aria-current={isCurrent('/electricidad-tableros-neuquen') ? 'page' : undefined}>Electricidad y Tableros</a>
          <a class="block px-4 py-2 text-sm text-on-surface hover:bg-surface-container-low transition-colors" href={url('/obras-trabajos-civiles-neuquen')} aria-current={isCurrent('/obras-trabajos-civiles-neuquen') ? 'page' : undefined}>Obras y Trabajos Civiles</a>
        </div>
      </div>

      <a class="text-on-surface-variant font-label-md text-label-md hover:text-secondary-container transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-secondary-container rounded" href={url('/#contacto')}>Contacto</a>
    </nav>

    <!-- Trailing Action Group -->
    <div class="flex items-center gap-space-md">
      <a class="hidden lg:flex touch-target items-center gap-2 font-technical-code text-technical-code text-on-surface-variant hover:text-primary transition-colors focus:outline-none focus:ring-2 focus:ring-secondary-container rounded p-1" href={`tel:${siteConfig.telephoneRaw}`} aria-label={`Llamar al ${siteConfig.telephoneDisplay}`}>
        <span class="material-symbols-outlined text-secondary-container text-base" data-icon="phone" aria-hidden="true">phone</span>
        <span class="font-semibold">{siteConfig.telephoneDisplay}</span>
      </a>
    </div>

  </div>

  <nav id="mobile-navigation" class="mobile-navigation md:hidden" aria-label="Navegación móvil" data-mobile-navigation>
    <div class="max-w-7xl mx-auto px-margin-mobile py-4">
      <div class="mobile-navigation-primary">
        <a class="mobile-navigation-link mobile-navigation-primary-link" href={url('/')} aria-current={isCurrent('/') ? 'page' : undefined}>Inicio</a>
        <a class="mobile-navigation-link mobile-navigation-primary-link" href={url('/#contacto')}>Contacto</a>
      </div>
      <div class="mobile-navigation-divider" aria-hidden="true"></div>
      <p class="mobile-navigation-label">Servicios</p>
      <div class="mobile-navigation-services">
        <a class="mobile-navigation-link mobile-navigation-service-link" href={url('/climatizacion-refrigeracion-neuquen')}>
          <svg class="mobile-service-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6L5.6 18.4" /></svg>
          <span>Climatización y Refrigeración</span>
        </a>
        <a class="mobile-navigation-link mobile-navigation-service-link" href={url('/mantenimiento-edilicio-neuquen')}>
          <svg class="mobile-service-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20h16M6 20V9l6-5 6 5v11M9 20v-5h6v5M9 10h.01M15 10h.01" /></svg>
          <span>Mantenimiento Edilicio</span>
        </a>
        <a class="mobile-navigation-link mobile-navigation-service-link" href={url('/electricidad-tableros-neuquen')}>
          <svg class="mobile-service-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13 2L5 13h6l-1 9 8-11h-6l1-9z" /></svg>
          <span>Electricidad y Tableros</span>
        </a>
        <a class="mobile-navigation-link mobile-navigation-service-link" href={url('/obras-trabajos-civiles-neuquen')}>
          <svg class="mobile-service-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20h16M6 20V8h12v12M4 8l8-5 8 5M9 20v-5h6v5" /></svg>
          <span>Obras y Trabajos Civiles</span>
        </a>
      </div>
      <a class="mobile-navigation-cta" href={getWhatsAppLink('Hola SIBJ, necesito pedir un presupuesto')} target="_blank" rel="noopener noreferrer">
        <svg class="mobile-cta-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 11.5a8 8 0 0 1-11.8 7.1L4 20l1.4-4A8 8 0 1 1 20 11.5Z" /><path d="M8.5 9.2c.3 2 2.3 4 4.3 4.3l1.1-.9c.2-.2.5-.2.8-.1l1.3.6c.3.1.4.5.3.8-.4 1.2-1.4 1.8-2.7 1.5-3.5-.8-6.2-3.5-7-7-.3-1.3.3-2.3 1.5-2.7.3-.1.7 0 .8.3l.6 1.3c.1.3.1.6-.1.8l-.9 1.1Z" /></svg>
        <span>Pedir presupuesto por WhatsApp</span>
      </a>
    </div>
  </nav>
</header>

<script>
  document.querySelectorAll<HTMLButtonElement>('.dropdown-toggle').forEach((toggle) => {
    const menu = toggle.closest('.group')?.querySelector<HTMLElement>('.dropdown-menu');
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      if (menu) {
        menu.hidden = expanded;
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        toggle.setAttribute('aria-expanded', 'false');
        if (menu) {
          menu.hidden = true;
        }
        toggle.focus();
      }
    });
  });

  const mobileMenuToggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
  const mobileNavigation = document.querySelector<HTMLElement>('#mobile-navigation');

  mobileMenuToggle?.addEventListener('click', () => {
    const expanded = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
    mobileMenuToggle.setAttribute('aria-expanded', String(!expanded));
    mobileMenuToggle.setAttribute('aria-label', expanded ? 'Abrir menú de navegación' : 'Cerrar menú de navegación');
    mobileNavigation?.setAttribute('data-open', String(!expanded));
  });

  mobileNavigation?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenuToggle?.setAttribute('aria-expanded', 'false');
      mobileMenuToggle?.setAttribute('aria-label', 'Abrir menú de navegación');
      mobileNavigation.setAttribute('data-open', 'false');
    });
  });
</script>