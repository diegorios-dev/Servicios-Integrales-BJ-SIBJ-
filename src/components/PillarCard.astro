---
interface Props {
  icono: string;
  titulo: string;
  texto: string;
  etiqueta: string;
}

const { icono, titulo, texto, etiqueta } = Astro.props;
---

<div class="reveal bg-surface-container-lowest p-space-lg rounded-xl border border-outline-variant/50 flex flex-col justify-between shadow-sm">
  <div>
    <div class="w-12 h-12 rounded-lg bg-surface-container-high flex items-center justify-center text-primary mb-space-md">
      <span class="material-symbols-outlined text-2xl" aria-hidden="true">{icono}</span>
    </div>
    <h3 class="font-headline-sm text-headline-sm text-primary mb-2">
      {titulo}
    </h3>
    <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
      {texto}
    </p>
  </div>
  <div class="mt-6 pt-3 border-t border-outline-variant/20 font-technical-code text-technical-code text-secondary-container font-bold">
    {etiqueta}
  </div>
</div>