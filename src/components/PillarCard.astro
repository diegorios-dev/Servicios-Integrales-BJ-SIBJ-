---
interface Props {
  icono: string;
  titulo: string;
  texto: string;
  etiqueta: string;
}

const { icono, titulo, texto, etiqueta } = Astro.props;
---

<article class="ui-card reveal group bg-surface-container-lowest p-6 sm:p-7 rounded-2xl border border-outline-variant/60 flex flex-col justify-between">
  <div>
    <div aria-hidden="true" class="icon-tile w-12 h-12 rounded-xl flex items-center justify-center mb-5">
      <span class="material-symbols-outlined shrink-0 text-2xl" aria-hidden="true">{icono}</span>
    </div>
    <h3 class="font-headline-sm text-headline-sm text-primary mb-2">
      {titulo}
    </h3>
    <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
      {texto}
    </p>
  </div>
  <div class="mt-6 pt-4 border-t border-outline-variant/40 font-technical-code text-technical-code text-secondary-container font-bold">
    {etiqueta}
  </div>
</article>