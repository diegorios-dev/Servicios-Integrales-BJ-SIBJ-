---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PillarCard from '../components/PillarCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import ContactSection from '../components/ContactSection.astro'
import CtaBanner from '../components/CtaBanner.astro';
import TrustSection from '../components/TrustSection.astro';
import { servicesData, pillarsData, testimonialsData } from '../data/services';
---

<Layout
  title="Mantenimiento integral para locales, comercios y empresas en Neuquén | SIBJ"
  description="Mantenimiento integral para locales, comercios y empresas en Neuquén. Climatización, mantenimiento edilicio, electricidad y obras civiles."
  ogTitle="Mantenimiento integral para locales, comercios y empresas en Neuquén | SIBJ"
  ogDescription="Mantenimiento integral para locales, comercios y empresas en Neuquén. Climatización, mantenimiento edilicio, electricidad y obras civiles."
  ogImage="/assets/hero-comercios.webp"
  ogImageAlt="Personal técnico realizando mantenimiento para comercios en Neuquén"
  ogImageWidth={862}
  ogImageHeight={841}
>
  <Hero />

  <!-- SERVICIOS SECTION -->
  <section class="py-space-2xl bg-surface-bright border-y border-outline-variant/20" id="servicios" aria-labelledby="services-title">
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin">
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-2xl border-b border-outline-variant/30 pb-space-lg">
        <div class="max-w-2xl">
          <p class="font-technical-code text-technical-code text-secondary-container font-extrabold uppercase tracking-wider block mb-1">
            Módulos Especializados
          </p>
          <h2 id="services-title" class="font-headline-xl text-headline-xl text-primary">
            Mantenimiento integral para locales, comercios y empresas
          </h2>
          <p class="font-body-md text-body-md text-on-surface-variant mt-2">
            Mantenimiento preventivo y correctivo de climatización, mantenimiento edilicio, electricidad y obras civiles en Neuquén.
          </p>
        </div>
      </div>

      <!-- Services Cards Grid: Restaurados los 4 servicios solicitados -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-space-lg">
        {servicesData.map((service) => (
          <ServiceCard 
            titulo={service.title}
            etiqueta={service.tag}
            icono={service.icon}
            descripcion={service.description}
            items={service.items}
            href={service.href}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- POR QUÉ ELEGIRNOS SECTION -->
  <section class="py-space-2xl bg-surface-container-low border-y border-outline-variant/30" id="nosotros" aria-labelledby="about-title">
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin">
      <!-- Section Intro -->
      <div class="max-w-3xl mb-space-2xl">
        <p class="font-technical-code text-technical-code text-secondary-container font-extrabold uppercase tracking-wider block mb-1">
          Propuesta de Valor Corporativa
        </p>
        <h2 id="about-title" class="font-headline-xl text-headline-xl text-primary">
          Soluciones para la continuidad de locales y comercios
        </h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant mt-2">
          Un solo interlocutor para coordinar mantenimiento y trabajos necesarios en Neuquén.
        </p>
      </div>

      <!-- Pilares en Cuadrícula -->
      <div class="grid grid-cols-1 gap-space-lg md:grid-cols-3">
        {pillarsData.map((pillar) => (
          <PillarCard 
            icono={pillar.icon}
            titulo={pillar.title}
            texto={pillar.text}
            etiqueta={pillar.number}
          />
        ))}
      </div>
    </div>
  </section>

  <TrustSection />

  <!-- TESTIMONIOS SECTION (Independiente y sin duplicación en servicios) -->
  <section class="bg-surface-bright border-y border-outline-variant/20 py-space-2xl" aria-labelledby="testimonials-title">
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin text-center">
      <div class="max-w-3xl mb-space-xl text-center mx-auto">
        <p class="font-technical-code text-technical-code text-secondary-container font-extrabold uppercase tracking-wider block mb-1">Casos de Éxito y Testimonios</p>
        <h2 id="testimonials-title" class="font-headline-xl text-headline-xl text-primary">Testimonios de Clientes</h2>
        <p class="font-body-md text-body-md text-on-surface-variant mt-2">Empresas y organizaciones que confían en nuestras soluciones técnicas para garantizar la continuidad operativa de sus instalaciones.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full text-left">
        {testimonialsData.map((testi) => (
          <TestimonialCard 
            etiqueta={testi.category}
            texto={testi.quote}
            cargo={testi.author}
            empresa={testi.role}
            rubro={testi.badge}
            imagen={testi.image}
            imagenAlt={testi.imageAlt}
            esTrabajo={testi.isWork}
          />
        ))}
      </div>
    </div>
  </section>

  <ContactSection />

  <!-- CTA BANNER -->
  <CtaBanner />

  <!-- SECCIÓN CONTACTO & COTIZACIÓN -->

</Layout>