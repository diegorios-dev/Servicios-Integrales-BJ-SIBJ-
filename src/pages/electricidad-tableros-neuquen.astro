---
import Layout from '../layouts/Layout.astro';
import { getWhatsAppLink, url } from '../data/site';

const services = [
  ['troubleshoot', 'Diagnóstico de fallas', 'Diagnóstico de fallas en instalaciones eléctricas.', 'Diagnóstico'],
  ['schema', 'Tableros', 'Revisión y trabajos en tableros.', 'Tableros'],
  ['toggle_on', 'Térmicas y contactores', 'Atención de térmicas y contactores.', 'Protecciones'],
  ['electrical_services', 'Instalaciones y reparaciones eléctricas', 'Instalaciones y reparaciones eléctricas para locales, comercios y empresas.', 'Electricidad'],
  ['bolt', 'Mantenimiento preventivo', 'Mantenimiento preventivo de instalaciones eléctricas.', 'Prevención'],
];

const segments = [
  ['factory', 'Empresas', 'Instalaciones eléctricas para empresas en Neuquén capital.'],
  ['oil_barrel', 'Comercios', 'Atención de instalaciones eléctricas de comercios.'],
  ['warehouse', 'Locales', 'Trabajos eléctricos para locales.'],
  ['store', 'Locales y comercios', 'Trabajos eléctricos para locales y comercios.'],
  ['local_shipping', 'Locales y empresas', 'Mantenimiento eléctrico para locales y empresas.'],
];

const faqs = [
  ['¿Qué trabajos realizan en tableros?', 'Realizamos revisión y trabajos en tableros, térmicas y contactores.'],
  ['¿Ofrecen mantenimiento preventivo?', 'Sí. Realizamos mantenimiento preventivo de instalaciones eléctricas.'],
  ['¿Realizan instalaciones y reparaciones eléctricas?', 'Sí. Realizamos instalaciones y reparaciones eléctricas para locales, comercios y empresas.'],
];

---

<Layout
  title="Electricidad y Tableros en Neuquén | SIBJ"
  description="Diagnóstico de fallas, tableros, térmicas y contactores, instalaciones y reparaciones eléctricas y mantenimiento preventivo en Neuquén."
  ogTitle="Electricidad y Tableros en Neuquén | SIBJ"
  ogDescription="Diagnóstico de fallas, tableros, térmicas y contactores, instalaciones y reparaciones eléctricas y mantenimiento preventivo en Neuquén."
  ogImage="/assets/hero-comercios.webp"
  ogImageAlt="Instalación eléctrica atendida por SIBJ en Neuquén"
  ogImageWidth={862}
  ogImageHeight={841}
  service={{ name: "Electricidad y Tableros", description: "Diagnóstico de fallas, tableros, térmicas y contactores, instalaciones y reparaciones eléctricas y mantenimiento preventivo en Neuquén capital." }}
  faqItems={faqs.map(([question, answer]) => ({ question, answer }))}
>
  <div class="service-page">
  <nav aria-label="Miga de pan" class="w-full bg-surface-container-low border-b border-outline-variant/40">
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin py-2.5">
      <ol class="flex items-center gap-2 text-body-sm text-on-surface-variant">
        <li><a class="hover:text-primary transition-colors" href={url('/')}>Inicio</a></li>
        <li><span class="material-symbols-outlined text-xs text-outline" aria-hidden="true">chevron_right</span></li>
        <li><span>Servicios</span></li>
        <li><span class="material-symbols-outlined text-xs text-outline" aria-hidden="true">chevron_right</span></li>
        <li aria-current="page" class="font-semibold text-primary">Electricidad y Tableros</li>
      </ol>
    </div>
  </nav>

  <section class="relative bg-surface py-20 lg:py-28 border-b border-outline-variant/30" aria-labelledby="electricidad-hero-title">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-7 flex flex-col items-start">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-high border border-outline-variant/50 text-label-sm text-primary mb-4">
            <span class="material-symbols-outlined text-secondary-container text-sm" aria-hidden="true">offline_bolt</span>
            <span>Servicio Eléctrico Especializado</span>
          </div>
          <h1 id="electricidad-hero-title" class="text-4xl lg:text-5xl font-display-lg font-extrabold text-primary tracking-tight leading-tight mb-5">Electricidad y tableros para locales, comercios y empresas en Neuquén</h1>
          <p class="text-body-lg font-body-lg text-on-surface-variant max-w-2xl mb-8">Diagnóstico de fallas, tableros, térmicas y contactores, instalaciones y reparaciones eléctricas y mantenimiento preventivo.</p>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto mb-10">
            <a class="cta-button-whatsapp inline-flex items-center justify-center gap-3 bg-secondary-container hover:bg-secondary text-on-secondary px-6 py-3.5 rounded-lg font-label-md text-label-md transition-all duration-150 shadow-md active:scale-95" href={getWhatsAppLink('Hola SIBJ, necesito presupuesto para Electricidad y Tableros en Neuquén')} target="_blank" rel="noopener noreferrer">
              <img src={url('/assets/whatsapp.png')} alt="" aria-hidden="true" class="w-6 h-6 object-contain" width="24" height="24" />
              <span>Pedir presupuesto por WhatsApp</span>
            </a>
            <a class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-primary hover:border-primary font-label-md text-label-md transition-all duration-150" href="tel:+5492994622512">
              <span class="material-symbols-outlined text-base" aria-hidden="true">call</span><span>+54 9 299 462-2512</span>
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 w-full border-t border-outline-variant/40 pt-6">
            <div class="flex items-center gap-2.5 p-2 bg-surface-container-lowest rounded-lg border border-outline-variant/40"><span class="material-symbols-outlined text-secondary-container" aria-hidden="true">domain</span><span class="text-label-md text-primary font-bold">Atención a empresas</span></div>
            <div class="flex items-center gap-2.5 p-2 bg-surface-container-lowest rounded-lg border border-outline-variant/40"><span class="material-symbols-outlined text-secondary-container" aria-hidden="true">location_on</span><span class="text-label-md text-primary font-bold">Cobertura en Neuquén</span></div>
            <div class="flex items-center gap-2.5 p-2 bg-surface-container-lowest rounded-lg border border-outline-variant/40"><span class="material-symbols-outlined text-secondary-container" aria-hidden="true">verified_user</span><span class="text-label-md text-primary font-bold">Normas de seguridad</span></div>
          </div>
        </div>
        <div class="lg:col-span-5 w-full">
          <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between border-b border-outline-variant/30 pb-4 mb-4">
              <div class="flex items-center gap-2"><span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-600 animate-pulse"></span><span class="text-label-sm uppercase tracking-wider text-on-surface-variant font-bold">Disponibilidad Operativa SIBJ</span></div>
              <span class="px-2 py-0.5 rounded text-label-sm bg-emerald-50 text-emerald-700 border border-emerald-200">En Servicio</span>
            </div>
            <div class="space-y-4">
              <div class="p-3 bg-surface-container-low rounded-lg border border-outline-variant/30 flex items-start gap-3"><span class="material-symbols-outlined text-secondary-container text-xl" aria-hidden="true">electric_meter</span><div><h4 class="text-label-md text-primary">Diagnóstico de fallas</h4><p class="text-body-sm text-on-surface-variant">Revisión de instalaciones eléctricas para localizar fallas.</p></div></div>
              <div class="p-3 bg-surface-container-low rounded-lg border border-outline-variant/30 flex items-start gap-3"><span class="material-symbols-outlined text-secondary-container text-xl" aria-hidden="true">security</span><div><h4 class="text-label-md text-primary">Mantenimiento preventivo</h4><p class="text-body-sm text-on-surface-variant">Tareas coordinadas de mantenimiento preventivo.</p></div></div>
              <div class="p-3 bg-surface-container-low rounded-lg border border-outline-variant/30 flex items-start gap-3"><span class="material-symbols-outlined text-secondary-container text-xl" aria-hidden="true">fact_check</span><div><h4 class="text-label-md text-primary">Instalaciones y reparaciones eléctricas</h4><p class="text-body-sm text-on-surface-variant">Trabajos eléctricos para locales, comercios y empresas.</p></div></div>
            </div>
            <div class="mt-5 pt-4 border-t border-outline-variant/30 flex justify-between items-center text-label-sm text-on-surface-variant"><span>Base Operativa: Neuquén Capital</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-surface-container-low border-b border-outline-variant/30" aria-labelledby="electricidad-services-title">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-16">
      <div class="max-w-3xl mb-12"><p class="text-label-sm uppercase tracking-wider text-secondary font-bold mb-2">Servicios eléctricos</p><h2 id="electricidad-services-title" class="text-headline-lg-mobile lg:text-headline-lg font-headline-lg font-bold text-primary tracking-tight">Qué hacemos</h2><p class="text-body-lg font-body-lg text-on-surface-variant mt-2">Trabajos eléctricos para locales, comercios y empresas en Neuquén capital.</p></div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map(([icon, title, description, label]) => <div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/60 shadow-sm hover:border-outline hover:shadow-md transition-all flex flex-col justify-between"><div><div class="w-12 h-12 rounded-lg bg-surface-container-high flex items-center justify-center text-primary mb-4"><span class="material-symbols-outlined text-2xl text-secondary-container" aria-hidden="true">{icon}</span></div><h3 class="text-headline-sm font-headline-sm text-primary mb-2.5">{title}</h3><p class="text-body-md text-on-surface-variant">{description}</p></div><div class="mt-6 pt-3 border-t border-outline-variant/20 flex items-center text-label-sm text-secondary font-semibold"><span class="material-symbols-outlined text-sm mr-1" aria-hidden="true">check_circle</span>{label}</div></div>)}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-surface-container-low border-b border-outline-variant/30" aria-labelledby="electricidad-segments-title">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-16">
      <div class="max-w-3xl mb-12"><p class="text-label-sm uppercase tracking-wider text-secondary font-bold mb-2">Clientes atendidos</p><h2 id="electricidad-segments-title" class="text-headline-lg-mobile lg:text-headline-lg font-headline-lg font-bold text-primary tracking-tight">Para quién trabajamos</h2><p class="text-body-lg font-body-lg text-on-surface-variant mt-2">Atención para locales, comercios y empresas en Neuquén capital.</p></div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {segments.map(([icon, title, description]) => <div class="bg-surface-container-lowest p-5 rounded-xl border border-outline-variant/50"><div class="p-2.5 rounded-lg bg-surface-container-high text-primary mb-3 w-fit"><span class="material-symbols-outlined text-2xl text-secondary-container" aria-hidden="true">{icon}</span></div><h3 class="text-label-md text-primary mb-1">{title}</h3><p class="text-body-sm text-on-surface-variant">{description}</p></div>)}
      </div>
    </div>
  </section>

  <section
    class="py-16 lg:py-24 border-b border-outline-variant/30 bg-cover bg-center"
    style={`background-image: linear-gradient(rgb(249 249 255 / 0.2), rgb(240 243 255 / 0.2)), url('${url('/assets/preguntas_frecuentes.webp')}');`}
    aria-labelledby="electricidad-faq-title"
  >
    <div class="max-w-4xl mx-auto px-margin-mobile md:px-margin"><div class="text-center max-w-2xl mx-auto mb-12"><p class="text-label-sm uppercase tracking-wider text-secondary font-bold mb-2">Respuestas Técnicas</p><h2 id="electricidad-faq-title" class="text-headline-lg-mobile lg:text-headline-lg font-headline-lg font-bold text-primary tracking-tight">Preguntas frecuentes</h2><p class="text-body-lg font-body-lg text-on-surface-variant mt-2">Aclaraciones sobre metodología, mantenimiento y seguridad eléctrica.</p></div><div class="space-y-4">{faqs.map(([question, answer]) => <details class="group bg-surface-container-lowest/90 border border-outline-variant/60 rounded-xl overflow-hidden shadow-sm"><summary class="w-full px-6 py-4 flex items-center justify-between gap-4 text-label-md text-primary cursor-pointer list-none"><span>{question}</span><span class="material-symbols-outlined text-outline group-open:rotate-180 transition-transform" aria-hidden="true">expand_more</span></summary><div class="px-6 pb-5 text-body-md text-on-surface-variant border-t border-outline-variant/20 pt-3">{answer}</div></details>)}</div></div>
  </section>

  <section class="py-16 bg-primary-container text-surface-container-lowest" id="contacto" aria-labelledby="electricidad-contact-title">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-16"><div class="bg-tertiary-container/60 border border-on-primary-container/20 rounded-2xl p-8 lg:p-12 flex flex-col lg:flex-row items-center justify-between gap-8"><div class="max-w-2xl text-center lg:text-left"><h2 id="electricidad-contact-title" class="text-headline-lg-mobile lg:text-headline-lg font-headline-lg font-bold tracking-tight mb-3">¿Necesitás asistencia técnica ahora?</h2><p class="text-body-lg text-on-primary-container">Atendemos requerimientos eléctricos para locales, comercios y empresas en Neuquén.</p></div><div class="flex flex-col sm:flex-row items-center gap-4 w-full lg:w-auto">    <a class="cta-button-whatsapp w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-secondary-container hover:bg-secondary text-on-secondary px-6 py-3.5 rounded-lg font-label-md transition-all shadow-md" href={getWhatsAppLink('Hola SIBJ, necesito asistencia técnica para Electricidad y Tableros en Neuquén')} target="_blank" rel="noopener noreferrer"><img src={url('/assets/whatsapp.png')} alt="" aria-hidden="true" class="w-5 h-5" width="20" height="20" /><span>WhatsApp</span></a><a class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-lg border border-on-primary-container/40 text-surface-container-lowest hover:bg-surface-container-lowest/10 font-label-md transition-all" href="tel:+5492994622512"><span class="material-symbols-outlined text-lg" aria-hidden="true">call</span><span>+54 9 299 462-2512</span></a></div></div></div>
  </section>
  </div>
</Layout>
