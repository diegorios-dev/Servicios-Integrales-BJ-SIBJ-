---
import Layout from '../layouts/Layout.astro';
import { getWhatsAppLink, url } from '../data/site';

const services = [
  ['construction', 'Albañilería', 'Construcción, ampliaciones y reparaciones.', 'Obra civil', 'arrow_forward'],
  ['home_repair_service', 'Reformas y remodelaciones', 'Viviendas, oficinas y locales comerciales.', 'Obra civil', 'arrow_forward'],
  ['grid_view', 'Pisos y revestimientos', 'Colocación y reparación.', 'Terminaciones', 'arrow_forward'],
  ['view_quilt', 'Construcción en seco', 'Tabiques, cielorrasos y divisiones.', 'Construcción', 'arrow_forward'],
  ['plumbing', 'Instalaciones sanitarias', 'Ejecución, reparación y adecuación.', 'Instalaciones', 'arrow_forward'],
  ['handyman', 'Mantenimiento edilicio', 'Reparaciones y mejoras de infraestructura.', 'Infraestructura', 'arrow_forward'],
];


const steps = [
  ['01', 'Consulta por WhatsApp', 'Recepción del requerimiento, análisis preliminar y coordinación inicial.'],
  ['02', 'Visita técnica y relevamiento', 'Inspección en Neuquén, toma de mediciones y verificación de interferencias.'],
  ['03', 'Cómputo de obra y ejecución', 'Desglose transparente de materiales y mano de obra conforme al plan acordado.'],
  ['04', 'Control de calidad y entrega', 'Verificación dimensional, limpieza técnica y entrega formal de la obra.'],
];

const segments = [
  ['business', 'Empresas e industrias', 'Trabajos civiles para empresas e industrias en Neuquén y Río Negro.'],
  ['storefront', 'Comercios', 'Adecuaciones y reparaciones de locales comerciales.'],
  ['home', 'Particulares', 'Reformas, ampliaciones y reparaciones de viviendas.'],
  ['factory', 'Infraestructura', 'Trabajos relacionados con construcción e infraestructura.'],
];

const faqs = [
  ['¿Qué trabajos civiles realizan?', 'Realizamos construcción, reformas, pisos y revestimientos, construcción en seco, instalaciones sanitarias y mantenimiento edilicio.'],
  ['¿Realizan instalaciones?', 'Sí. Realizamos instalaciones relacionadas con obras y trabajos civiles.'],
  ['¿Cómo se coordinan los trabajos?', 'Coordinamos las tareas y los horarios con el cliente.'],
  ['¿Tienen un trabajo realizado con biodigestor?', 'Sí. Instalación de sistema sanitario con biodigestor para el tratamiento de aguas residuales.'],
];

---

<Layout
  title="Obras Civiles en Neuquén | Servicios Integrales BJ"
  description="Obras, reformas y trabajos civiles para empresas, comercios y particulares en Neuquén y Río Negro. Coordinamos presupuestos y proyectos a cada necesidad."
  ogTitle="Obras Civiles en Neuquén | Servicios Integrales BJ"
  ogDescription="Obras, reformas y trabajos civiles para empresas, comercios y particulares en Neuquén y Río Negro. Coordinamos presupuestos y proyectos a cada necesidad."
  ogImage="/assets/civiles.jpeg"
  ogImageAlt="Técnico de SIBJ realizando trabajos civiles en Neuquén"
  ogImageWidth={1280}
  ogImageHeight={960}
  service={{ name: "Obras y Trabajos Civiles", description: "Soluciones integrales en construcción, reformas y mantenimiento para empresas, industrias, comercios y particulares en Neuquén." }}
  faqItems={faqs.map(([question, answer]) => ({ question, answer }))}
>
  <div class="service-page">
  <nav aria-label="Miga de pan" class="bg-surface border-b border-outline-variant">
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin py-3">
      <ol class="flex flex-wrap items-center text-body-sm text-on-surface-variant gap-2">
        <li><a class="hover:text-primary transition-colors" href={url('/')}>Inicio</a></li>
        <li aria-hidden="true" class="text-outline">›</li>
        <li><a class="hover:text-primary transition-colors" href={url('/#servicios')}>Servicios</a></li>
        <li aria-hidden="true" class="text-outline">›</li>
        <li aria-current="page" class="text-primary font-semibold">Obras y Trabajos Civiles</li>
      </ol>
    </div>
  </nav>

  <section class="bg-surface-container-lowest border-b border-outline-variant py-16 lg:py-24" aria-labelledby="obras-hero-title">
    <div class="w-full max-w-7xl mx-auto px-margin-mobile md:px-margin">
      <div class="civil-hero-grid">
        <div class="min-w-0 w-full flex flex-col items-start">
          <span class="hero-eyebrow mb-4">
            <span class="material-symbols-outlined" aria-hidden="true">apartment</span>
            Obras y trabajos civiles
          </span>
          <h1 id="obras-hero-title" class="w-full max-w-4xl text-4xl lg:text-5xl font-headline-lg font-extrabold text-primary tracking-tight leading-tight mb-5">Mantenimiento edilicio integral <span class="text-accent">en Neuquén.</span></h1>
          <p class="text-body-lg text-on-surface-variant mb-8 max-w-3xl">Soluciones integrales en construcción, reformas y mantenimiento para empresas, industrias, comercios y particulares.</p>
          <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto mb-8">
            <a class="cta-button-whatsapp bg-secondary-container hover:bg-secondary text-on-secondary font-label-md px-6 py-3.5 rounded flex items-center justify-center gap-3 transition-all shadow-sm" href={getWhatsAppLink('Hola SIBJ, necesito presupuesto para Obras y Trabajos Civiles en Neuquén')} target="_blank" rel="noopener noreferrer">
              <img src={url('/assets/whatsapp.png')} alt="" aria-hidden="true" class="w-5 h-5 object-contain" width="20" height="20" />
              <span>Pedir presupuesto por WhatsApp</span>
            </a>
            <a class="border border-outline-variant hover:border-primary bg-surface-container-lowest text-primary font-label-md px-6 py-3.5 rounded flex items-center justify-center gap-2 transition-all" href="tel:+5492995064187">
              <span class="material-symbols-outlined text-secondary" aria-hidden="true">call</span><span>Llamar a operaciones</span>
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 w-full border-t border-outline-variant pt-6">
            <div class="flex items-center gap-2.5"><span class="material-symbols-outlined shrink-0 w-5 text-secondary" aria-hidden="true">corporate_fare</span><span class="font-label-md text-on-surface">Atención a empresas, industrias, comercios y particulares</span></div>
            <div class="flex items-center gap-2.5"><span class="material-symbols-outlined shrink-0 w-5 text-secondary" aria-hidden="true">location_on</span><span class="font-label-md text-on-surface">Cobertura en Neuquén y Río Negro</span></div>
            <div class="flex items-center gap-2.5"><span class="material-symbols-outlined shrink-0 w-5 text-secondary" aria-hidden="true">verified_user</span><span class="font-label-md text-on-surface">Normas de seguridad</span></div>
          </div>
        </div>
        <div class="civil-panel-column min-w-0 w-full">
          <div class="civil-panel relative w-full min-w-0 rounded-xl overflow-hidden border border-outline-variant shadow-lg">
            <img src={url('/assets/civiles.jpeg')} alt="Técnico de SIBJ realizando trabajos de albañilería y hormigón" class="w-full h-[420px] sm:h-[500px] lg:h-[560px] object-cover object-center" width="800" height="560" fetchpriority="high" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24 max-w-7xl mx-auto px-margin-mobile md:px-margin" aria-labelledby="obras-services-title">
    <div class="text-left mb-10 max-w-3xl"><p class="text-label-sm text-secondary uppercase tracking-wider">Especialidades Operativas</p><h2 id="obras-services-title" class="text-3xl lg:text-4xl font-headline-lg font-bold text-primary mt-1">Qué hacemos</h2><p class="text-body-md text-on-surface-variant mt-2">Soluciones integrales de obra civil y sanitaria proyectadas bajo normas técnicas de construcción y seguridad operativa.</p></div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map(([icon, title, description, label, footerIcon]) => <article class="group bg-surface-container-lowest border border-outline-variant rounded-lg p-6 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-secondary"><div><div class="icon-tile w-12 h-12 rounded-xl flex items-center justify-center mb-5" aria-hidden="true"><span class="material-symbols-outlined shrink-0 text-2xl" aria-hidden="true">{icon}</span></div><h3 class="text-lg font-bold text-primary mb-2">{title}</h3><p class="text-body-md text-on-surface-variant">{description}</p></div><div class="mt-6 pt-4 border-t border-outline-variant flex items-center justify-between text-label-sm text-on-surface-variant"><span>{label}</span><span class="material-symbols-outlined shrink-0 text-sm text-secondary transition-transform group-hover:translate-x-1" aria-hidden="true">{footerIcon}</span></div></article>)}
    </div>
  </section>

  <section class="bg-surface-container-lowest border-y border-outline-variant py-16 lg:py-24" aria-labelledby="obras-process-title">
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin">
      <div class="text-left mb-12 max-w-3xl"><p class="text-label-sm text-secondary uppercase tracking-wider">Metodología de Trabajo</p><h2 id="obras-process-title" class="text-3xl lg:text-4xl font-headline-lg text-primary mt-1">Cómo trabajamos</h2><p class="text-body-md text-on-surface-variant mt-2">Un proceso ordenado y transparente que prioriza la precisión y el cumplimiento de cada etapa técnica.</p></div>
      <div class="relative grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="hidden lg:block absolute top-6 left-[12%] right-[12%] h-px bg-outline-variant" aria-hidden="true"></div>
        {steps.map(([number, title, description]) => <div class="relative bg-surface border border-outline-variant rounded-lg p-6"><div class="relative z-10 w-12 h-12 rounded-full bg-secondary text-on-secondary font-bold flex items-center justify-center mb-4">{number}</div><h3 class="font-bold text-primary mb-2">{title}</h3><p class="text-body-md text-on-surface-variant">{description}</p></div>)}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24 max-w-7xl mx-auto px-margin-mobile md:px-margin" aria-labelledby="obras-segments-title">
    <div class="text-left mb-10 max-w-3xl"><p class="text-label-sm text-secondary uppercase tracking-wider">Sectores y Rubros</p><h2 id="obras-segments-title" class="text-3xl lg:text-4xl font-headline-lg text-primary mt-1">Para quién trabajamos</h2><p class="text-body-md text-on-surface-variant mt-2">Atendemos las necesidades operativas e infraestructurales de empresas, comercios y particulares en Neuquén y Río Negro.</p></div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {segments.map(([icon, title, description]) => <div class="border border-outline-variant bg-surface-container-lowest p-6 rounded flex items-start gap-4"><span class="icon-tile inline-flex w-12 h-12 shrink-0 items-center justify-center rounded-xl" aria-hidden="true"><span class="material-symbols-outlined text-2xl">{icon}</span></span><div><h3 class="font-label-md text-primary mb-1">{title}</h3><p class="text-body-md text-on-surface-variant">{description}</p></div></div>)}
    </div>
  </section>

  <section
    class="py-16 lg:py-24 border-y border-outline-variant/60 bg-cover bg-center"
    style={`background-image: linear-gradient(rgb(249 249 255 / 0.2), rgb(240 243 255 / 0.2)), url('${url('/assets/preguntas_frecuentes.webp')}');`}
    aria-labelledby="obras-faq-title"
  >
    <div class="max-w-4xl mx-auto px-margin-mobile md:px-margin">
      <div class="text-left mb-10"><p class="text-label-sm text-secondary uppercase tracking-wider text-extrabold">Aclaraciones Operativas</p><h2 id="obras-faq-title" class="text-3xl lg:text-4xl font-headline-lg text-primary mt-1">Preguntas frecuentes</h2><p class="text-body-md text-on-surface-variant mt-2">Respuestas sobre intervenciones civiles y sistemas de tratamiento de aguas residuales.</p></div>
      <div class="space-y-4">{faqs.map(([question, answer]) => <details class="border border-outline-variant rounded bg-surface-container-lowest/90 overflow-hidden shadow-sm"><summary class="w-full px-6 py-4 flex justify-between items-center gap-4 hover:bg-surface-container transition-colors text-label-md text-primary cursor-pointer list-none"><span>{question}</span><span class="material-symbols-outlined text-secondary" aria-hidden="true">expand_more</span></summary><div class="px-6 pb-4 pt-3 text-body-md text-on-surface-variant border-t border-surface-container">{answer}</div></details>)}</div>
    </div>
  </section>

  <section class="cta-v-concrete py-16 md:py-20 text-primary" id="contacto" aria-labelledby="obras-contact-title">
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin"><div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 cta-card p-8 lg:p-10 rounded-2xl"><div><p class="text-label-sm text-secondary-fixed uppercase tracking-wider text-extrabold">Atención Directa</p><h2 id="obras-contact-title" class="text-2xl lg:text-3xl font-headline-lg font-bold mt-1">¿Necesita asistencia técnica ahora?</h2><p class="text-body-md text-on-primary-container mt-1 max-w-xl">Coordine una visita técnica o envíe el plano de su obra para un análisis y cotización.</p></div><div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto"><a href={getWhatsAppLink('Hola SIBJ, necesito presupuesto para Obras y Trabajos Civiles en Neuquén')} target="_blank" rel="noopener noreferrer" class="cta-button-whatsapp bg-secondary-container hover:bg-secondary text-on-secondary font-bold px-6 py-3.5 rounded-lg flex items-center justify-center gap-2 shadow-sm transition-all"><img src={url('/assets/whatsapp.png')} alt="" aria-hidden="true" class="w-5 h-5" width="20" height="20" />Pedir presupuesto por WhatsApp</a><a href="tel:+5492995064187" class="border border-outline bg-surface-container-lowest text-primary font-bold hover:bg-surface-container-low hover:border-primary px-6 py-3.5 rounded-lg flex items-center justify-center gap-2 transition-colors"><span class="material-symbols-outlined text-lg" aria-hidden="true">call</span>+54 9 299 506-4187</a></div></div></div>
  </section>
  </div>
</Layout>

<style>
  .civil-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    width: 100%;
  }

  details[open] summary .material-symbols-outlined {
    transform: rotate(180deg);
    transition: transform .2s ease;
  }

  @media (min-width: 1024px) {
    .civil-hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }

    .civil-panel-column {
      display: flex;
      justify-content: flex-end;
    }

    .civil-panel {
      max-width: none;
    }
  }
</style>
