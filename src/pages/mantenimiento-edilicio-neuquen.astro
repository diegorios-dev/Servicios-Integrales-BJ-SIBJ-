---
import Layout from '../layouts/Layout.astro';
import { getWhatsAppLink, url } from '../data/site';

const services = [
  ['handyman', 'Reparaciones generales', 'Reparaciones generales para locales, comercios y empresas.', 'Mantenimiento edilicio'],
  ['format_paint', 'Pintura', 'Trabajos de pintura para renovar y mantener los espacios.', 'Terminaciones'],
  ['grid_view', 'Cambio de pisos/baldosas', 'Cambio de pisos/baldosas según las necesidades del local.', 'Locales'],
  ['plumbing', 'Plomería', 'Trabajos de plomería para el mantenimiento de las instalaciones.', 'Instalaciones'],
  ['water_damage', 'Destapes y pérdidas', 'Atención de destapes y pérdidas.', 'Mantenimiento'],
  ['assignment_turned_in', 'Mantenimiento preventivo de locales', 'Mantenimiento preventivo de locales con tareas coordinadas.', 'Prevención'],
];

const steps = [
  ['01', 'Consulta por WhatsApp', 'Recepción del requerimiento, fotografías o planos y descripción preliminar de la necesidad.'],
  ['02', 'Relevamiento en sitio', 'Inspección técnica para dimensionar materiales, accesibilidad y riesgos de maniobra.'],
  ['03', 'Ejecución planificada', 'Implementación segura de las tareas reduciendo interferencias con la actividad habitual.'],
  ['04', 'Seguimiento y entrega', 'Control de calidad, conformidad del responsable e informe de tareas concluidas.'],
];

const segments = [
  ['storefront', 'Comercios y Locales', 'Salones de venta, franquicias gastronómicas y locales que requieren respuesta rápida.'],
  ['warehouse', 'Locales comerciales', 'Espacios comerciales que requieren mantenimiento coordinado.'],
  ['factory', 'Empresas', 'Mantenimiento para empresas en Neuquén capital.'],
  ['domain', 'Oficinas Corporativas', 'Sedes administrativas y sucursales con mantenimiento silencioso y prolijo.'],
];

const faqs = [
  ['¿Qué tipo de mantenimiento edilicio realizan?', 'Atendemos reparaciones generales, pintura, cambio de pisos/baldosas, plomería, destapes y pérdidas, y mantenimiento preventivo de locales.'],
  ['¿Trabajan con planes preventivos para empresas?', 'Sí, diseñamos rutinas periódicas de revisión hidrosanitaria, cerramientos, cubiertas y pintura, con informes y prioridad para urgencias.'],
  ['¿Qué zona geográfica cubren?', 'Nuestra cobertura es Neuquén capital.'],
  ['¿Pueden trabajar sin interrumpir la actividad?', 'Coordinamos las tareas por etapas u horarios programados para minimizar la interferencia con la operación del cliente.'],
];

---

<Layout
  title="Mantenimiento Edilicio en Neuquén | SIBJ"
  description="Reparaciones generales, pintura, cambio de pisos/baldosas, plomería, destapes y pérdidas, y mantenimiento preventivo de locales en Neuquén."
  ogTitle="Mantenimiento Edilicio en Neuquén | SIBJ"
  ogDescription="Reparaciones generales, pintura, cambio de pisos/baldosas, plomería, destapes y pérdidas, y mantenimiento preventivo de locales en Neuquén."
  ogImage="/assets/mantenimiento_edilicio.jpg"
  ogImageAlt="Técnico de SIBJ realizando mantenimiento edilicio en Neuquén"
  ogImageWidth={2560}
  ogImageHeight={1435}
  service={{ name: "Mantenimiento Edilicio", description: "Reparaciones generales, pintura, cambio de pisos/baldosas, plomería, destapes y pérdidas, y mantenimiento preventivo de locales en Neuquén capital." }}
  faqItems={faqs.map(([question, answer]) => ({ question, answer }))}
>
  <div class="service-page">
  <nav aria-label="Migas de pan" class="bg-surface-container-low border-b border-outline-variant/40">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-16 py-3">
      <div class="flex items-center gap-2 text-body-sm text-on-surface-variant">
        <a class="hover:text-primary transition-colors" href={url('/')}>Inicio</a>
        <span class="material-symbols-outlined text-[14px]" aria-hidden="true">chevron_right</span>
        <span>Servicios</span>
        <span class="material-symbols-outlined text-[14px]" aria-hidden="true">chevron_right</span>
        <span class="text-primary font-semibold">Mantenimiento Edilicio</span>
      </div>
    </div>
  </nav>

  <section class="py-16 lg:py-24 bg-surface-container-lowest border-b border-outline-variant/60" aria-labelledby="edilicio-hero-title">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-6 flex flex-col items-start gap-6">
          <h1 id="edilicio-hero-title" class="text-4xl lg:text-5xl font-display-lg font-bold text-primary tracking-tight leading-tight">Mantenimiento edilicio para locales, comercios y empresas en Neuquén</h1>
          <p class="text-body-lg text-on-surface-variant max-w-2xl leading-relaxed">Reparaciones generales, pintura, cambio de pisos/baldosas, plomería, destapes y pérdidas, y mantenimiento preventivo de locales.</p>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto pt-2">
            <a class="cta-button-whatsapp bg-secondary-container hover:bg-secondary text-on-secondary px-6 py-3.5 rounded-lg font-label-md flex items-center justify-center gap-3 transition-all shadow-sm" href={getWhatsAppLink('Hola SIBJ, necesito presupuesto para Mantenimiento Edilicio en Neuquén')} target="_blank" rel="noopener noreferrer">
              <img src={url('/assets/whatsapp.png')} alt="" aria-hidden="true" class="w-5 h-5" width="20" height="20" />
              <span>Pedir presupuesto por WhatsApp</span>
            </a>
            <a class="bg-surface-container-lowest border border-outline hover:border-primary text-primary px-5 py-3.5 rounded-lg font-label-md flex items-center justify-center gap-2" href="tel:+5492994622512"><span class="material-symbols-outlined text-[18px]" aria-hidden="true">phone</span>+54 9 299 462-2512</a>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-label-sm bg-surface-container border border-outline-variant/60 text-primary"><span class="material-symbols-outlined text-[16px] text-secondary-container" aria-hidden="true">corporate_fare</span>Atención a empresas</span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-label-sm bg-surface-container border border-outline-variant/60 text-primary"><span class="material-symbols-outlined text-[16px] text-secondary-container" aria-hidden="true">location_on</span>Cobertura en Neuquén</span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-label-sm bg-surface-container border border-outline-variant/60 text-primary"><span class="material-symbols-outlined text-[16px] text-secondary-container" aria-hidden="true">security</span>Normas de seguridad</span>
          </div>
        </div>
        <div class="lg:col-span-6">
          <div class="relative rounded-xl overflow-hidden border border-outline-variant bg-surface-container shadow-sm">
            <img src={url('/assets/mantenimiento_edilicio.jpg')} alt="Técnico de SIBJ realizando mantenimiento edilicio en Neuquén" class="w-full h-[420px] sm:h-[500px] lg:h-[560px] object-cover object-center" width="800" height="560" fetchpriority="high" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-background" id="servicios" aria-labelledby="edilicio-services-title">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-16">
      <div class="max-w-3xl mb-12"><p class="text-label-md uppercase tracking-wider text-secondary font-bold">Mantenimiento edilicio</p><h2 id="edilicio-services-title" class="text-3xl lg:text-4xl font-headline-lg font-bold text-primary mt-2">Qué hacemos</h2><p class="text-body-md text-on-surface-variant mt-2">Ejecución técnica adaptada a locales, comercios y empresas en Neuquén capital.</p></div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map(([icon, title, description, label]) => <div class="bg-surface-container-lowest border border-outline-variant p-6 rounded-xl transition-all hover:shadow-md flex flex-col justify-between"><div><div class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center text-primary mb-4"><span class="material-symbols-outlined text-[26px]" aria-hidden="true">{icon}</span></div><h3 class="text-label-md font-bold text-primary mb-2">{title}</h3><p class="text-body-md text-on-surface-variant">{description}</p></div><div class="pt-4 mt-4 border-t border-surface-container flex items-center gap-1.5 text-label-sm text-secondary font-semibold"><span class="material-symbols-outlined text-[16px]" aria-hidden="true">check_circle</span>{label}</div></div>)}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-surface-container-lowest border-y border-outline-variant/60" aria-labelledby="edilicio-process-title">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-16">
      <div class="text-center max-w-2xl mx-auto mb-16"><p class="text-label-md uppercase tracking-wider text-secondary font-extrabold">Metodología Racional</p><h2 id="edilicio-process-title" class="text-3xl lg:text-4xl font-headline-lg font-bold text-primary mt-2">Cómo trabajamos</h2><p class="text-body-md text-on-surface-variant mt-2">Un flujo estructurado para garantizar diagnósticos reales, presupuestos detallados y tiempos convenidos.</p></div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {steps.map(([number, title, description]) => <div class="p-6 rounded-xl border border-outline-variant bg-surface-container-low flex flex-col justify-between"><div><span class="text-headline-lg font-headline-lg font-extrabold text-secondary-container">{number}</span><h3 class="text-label-md font-bold text-primary mt-3 mb-2">{title}</h3><p class="text-body-md text-on-surface-variant">{description}</p></div><div class="mt-6 pt-3 border-t border-outline-variant/40 text-label-sm text-on-surface-variant">Proceso técnico controlado</div></div>)}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-background" aria-labelledby="edilicio-segments-title">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-16">
      <div class="max-w-3xl mb-12"><p class="text-label-md uppercase tracking-wider text-secondary font-extrabold">Segmentos Atendidos</p><h2 id="edilicio-segments-title" class="text-3xl lg:text-4xl font-headline-lg font-bold text-primary mt-2">Para quién trabajamos</h2><p class="text-body-md text-on-surface-variant mt-2">Soporte operativo para empresas que necesitan resolver infraestructura sin desviar recursos de su negocio central.</p></div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {segments.map(([icon, title, description]) => <div class="bg-surface-container-lowest border border-outline-variant p-6 rounded-xl"><div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary mb-4"><span class="material-symbols-outlined text-[22px]" aria-hidden="true">{icon}</span></div><h3 class="text-label-md font-bold text-primary mb-2">{title}</h3><p class="text-body-md text-on-surface-variant">{description}</p></div>)}
      </div>
    </div>
  </section>


  <section class="py-16 lg:py-24 border-y border-outline-variant/60 bg-background" aria-labelledby="edilicio-faq-title">
    <div class="max-w-4xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="max-w-3xl mb-10"><p class="text-label-md uppercase tracking-wider text-secondary font-extrabold">Aclaraciones Operativas</p><h2 id="edilicio-faq-title" class="text-3xl lg:text-4xl font-headline-lg font-bold text-primary mt-2">Preguntas frecuentes</h2><p class="text-body-md text-on-surface-variant mt-2">Respuestas sobre mantenimiento edilicio y planes preventivos.</p></div>
      <div class="space-y-4">{faqs.map(([question, answer]) => <details class="group bg-surface-container-lowest/90 border border-outline-variant rounded-xl p-5 shadow-sm"><summary class="flex items-center justify-between cursor-pointer list-none text-label-md font-bold text-primary"><span>{question}</span><span class="material-symbols-outlined text-secondary group-open:rotate-180 transition-transform" aria-hidden="true">expand_more</span></summary><div class="mt-4 pt-4 border-t border-surface-container text-body-md text-on-surface-variant leading-relaxed">{answer}</div></details>)}</div>
    </div>
  </section>

  <section class="py-16 bg-primary-container text-surface-bright border-y border-primary" id="contacto" aria-labelledby="edilicio-contact-title">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-16">
      <div class="bg-tertiary-container/60 border border-outline-variant/30 rounded-xl p-8 lg:p-12 flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="max-w-2xl text-center md:text-left">
        <p class="text-label-sm uppercase tracking-wider text-secondary-fixed font-bold">Respuesta Técnica en Neuquén</p>
        <h2 id="edilicio-contact-title" class="text-3xl font-headline-lg font-bold text-surface-container-lowest mt-2">¿Necesitás asistencia técnica ahora?</h2>
        <p class="text-body-md text-on-primary-container mt-2">Coordinamos un relevamiento sin compromiso en tu comercio o depósito.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto">    
        <a class="cta-button-whatsapp w-full sm:w-auto bg-secondary-container hover:bg-secondary text-on-secondary px-6 py-3.5 rounded-lg font-label-md flex items-center justify-center gap-2.5 shadow-md" href={getWhatsAppLink('Hola SIBJ, necesito asistencia técnica para un servicio edilicio')} target="_blank" rel="noopener noreferrer"><img src={url('/assets/whatsapp.png')} alt="" aria-hidden="true" class="w-5 h-5" width="20" height="20" />WhatsApp</a><a class="w-full sm:w-auto border border-outline-variant/50 text-surface-bright px-6 py-3.5 rounded-lg font-label-md flex items-center justify-center gap-2" href="tel:+5492994622512"><span class="material-symbols-outlined text-[18px]" aria-hidden="true">call</span>+54 9 299-462-2512</a>
      </div>
    </div>
    </div>
  </section>
  </div>
  
</Layout>
