---
import { siteConfig, url } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  service?: {
    name: string;
    description: string;
  };
  faqItems?: Array<{
    question: string;
    answer: string;
  }>;
  pageClass?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage,
  ogImageAlt = "Logo de Servicios Integrales BJ",
  ogImageWidth = 1254,
  ogImageHeight = 1254,
  service,
  faqItems = [],
  pageClass,
  noindex = false,
} = Astro.props;

const siteRoot = new URL(import.meta.env.BASE_URL, Astro.site);
const basePath = siteRoot.pathname.endsWith('/') ? siteRoot.pathname : `${siteRoot.pathname}/`;
const routePath = Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname.slice(basePath.length)
  : Astro.url.pathname.replace(/^\/+/, '');
const absoluteUrl = (path: string) => new URL(path.replace(/^\/+/, ''), siteRoot).toString();
const canonicalUrl = absoluteUrl(routePath);
const logoUrl = absoluteUrl('assets/logo1.png');
const socialImageUrl = ogImage ? absoluteUrl(ogImage) : logoUrl;

const siteUrl = absoluteUrl('');
const businessId = `${siteUrl}#business`;
const websiteId = `${siteUrl}#website`;
const webpageId = `${canonicalUrl}#webpage`;
const imageExtension = socialImageUrl.split('.').pop()?.toLowerCase();
const ogImageType = ({ jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp' } as Record<string, string>)[imageExtension ?? ''];

const areaServed = [
  {
    "@type": "City",
    "name": "Neuquén",
    "containedInPlace": { "@type": "AdministrativeArea", "name": "Provincia del Neuquén" },
  },
  { "@type": "AdministrativeArea", "name": "Provincia del Neuquén" },
  { "@type": "AdministrativeArea", "name": "Provincia de Río Negro" },
];

const businessNode = {
  "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
  "@id": businessId,
  "name": siteConfig.name,
  "alternateName": siteConfig.shortName,
  "description": "Mantenimiento edilicio preventivo y correctivo, obras civiles y reformas, climatización y refrigeración, y electricidad y tableros para empresas, comercios y particulares en Neuquén y Río Negro.",
  "url": siteUrl,
  "logo": {
    "@type": "ImageObject",
    "url": logoUrl,
    "width": 1254,
    "height": 1254,
  },
  "image": [absoluteUrl('assets/hero-comercios.webp'), logoUrl],
  "telephone": siteConfig.telephoneRaw,
  "email": siteConfig.email,
  "contactPoint": [{
    "@type": "ContactPoint",
    "contactType": "customer service",
    "telephone": siteConfig.telephoneRaw,
    "email": siteConfig.email,
    "areaServed": "AR",
    "availableLanguage": ["es"],
  }],
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": siteConfig.openingHours.days,
    "opens": siteConfig.openingHours.opens,
    "closes": siteConfig.openingHours.closes,
  }],
  "areaServed": areaServed,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": siteConfig.city,
    "addressRegion": siteConfig.region,
    "addressCountry": siteConfig.addressCountry,
  },
  "knowsAbout": siteConfig.serviceCatalog,
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicios de mantenimiento y obras",
    "itemListElement": siteConfig.serviceCatalog.map((name) => ({
      "@type": "Offer",
      "itemOffered": { "@type": "Service", "name": name },
    })),
  },
};

const websiteNode = {
  "@type": "WebSite",
  "@id": websiteId,
  "name": siteConfig.name,
  "alternateName": siteConfig.shortName,
  "url": siteUrl,
  "inLanguage": "es-AR",
  "publisher": { "@id": businessId },
};

const breadcrumbNode = service
  ? {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Servicios", "item": absoluteUrl('#servicios') },
        { "@type": "ListItem", "position": 3, "name": service.name, "item": canonicalUrl }
      ]
    }
  : null;

const webpageNode = !noindex
  ? {
      "@type": "WebPage",
      "@id": webpageId,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "inLanguage": "es-AR",
      "isPartOf": { "@id": websiteId },
      "about": { "@id": businessId },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": socialImageUrl,
        "width": ogImageWidth,
        "height": ogImageHeight,
      },
      ...(breadcrumbNode ? { "breadcrumb": { "@id": breadcrumbNode["@id"] } } : {}),
    }
  : null;

const serviceNode = service
  ? {
      "@type": "Service",
      "@id": `${canonicalUrl}#service`,
      "name": service.name,
      "description": service.description,
      "url": canonicalUrl,
      "serviceType": service.name,
      "areaServed": areaServed,
      "provider": { "@id": businessId },
      "mainEntityOfPage": { "@id": webpageId },
    }
  : null;

const faqNode = faqItems.length
  ? {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "isPartOf": { "@id": webpageId },
      "mainEntity": faqItems.map(({ question, answer }) => ({
        "@type": "Question",
        "name": question,
        "acceptedAnswer": { "@type": "Answer", "text": answer }
      }))
    }
  : null;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [businessNode, websiteNode, webpageNode, serviceNode, breadcrumbNode, faqNode].filter(Boolean),
};
---

<!DOCTYPE html>
<html class="scroll-smooth" lang="es-AR">
<head>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}>
  <meta name="theme-color" content="#000919">
  
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:type" content="website">
  {!noindex && <link rel="canonical" href={canonicalUrl}>}
  {!noindex && <meta property="og:url" content={canonicalUrl}>}
  <meta property="og:locale" content="es_AR">
  <meta property="og:site_name" content={siteConfig.name}>
  <meta property="og:image" content={socialImageUrl}>
  <meta property="og:image:secure_url" content={socialImageUrl}>
  {ogImageType && <meta property="og:image:type" content={ogImageType}>}
  <meta property="og:image:alt" content={ogImageAlt}>
  <meta property="og:image:width" content={ogImageWidth}>
  <meta property="og:image:height" content={ogImageHeight}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={ogTitle}>
  <meta name="twitter:description" content={ogDescription}>
  <meta name="twitter:image" content={socialImageUrl}>
  <meta name="twitter:image:alt" content={ogImageAlt}>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <link rel="icon" href={url('/favicon.ico')} sizes="any">
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')}>
  <link rel="apple-touch-icon" href={url('/assets/logo1.png')}>
  <link rel="sitemap" type="application/xml" href={absoluteUrl('sitemap-index.xml')}>

  <!-- Google Fonts: Hanken Grotesk & Manrope -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..900;1,300..900&family=Manrope:wght@300..800&display=swap" rel="stylesheet">
  
  <!-- Material Symbols Outlined -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL@20..48,100..700,0..1&icon_names=ac_unit,add,apartment,arrow_forward,assignment_turned_in,badge,bolt,build,business,call,carpenter,check_circle,chevron_right,cleaning_services,corporate_fare,construction,design_services,domain,electric_meter,electrical_services,engineering,expand_more,fact_check,factory,file_open,format_paint,grid_goldenratio,grid_view,handyman,home,home_repair_service,location_on,local_shipping,mail,mode_fan,offline_bolt,oil_barrel,phone,plumbing,precision_manufacturing,propane_tank,ramp_right,recycling,remove,roofing,schedule,schema,search_check,security,shield,square_foot,store,storefront,sync,toggle_on,troubleshoot,umbrella,verified,verified_user,view_quilt,water,water_damage,warehouse&display=swap" rel="stylesheet">
</head>
<body class:list={['bg-background text-on-surface antialiased selection:bg-secondary-container selection:text-on-primary', pageClass]}>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <div class="header-sentinel" data-header-sentinel aria-hidden="true"></div>
  <Header />
  <main id="contenido" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <FloatingWhatsApp />
</body>
</html>

<script>
  document.querySelectorAll<HTMLElement>('main > section:not(#inicio), main > .service-page > section:not(:first-child)')
    .forEach((section) => section.classList.add('reveal'));
  const revealElements = document.querySelectorAll<HTMLElement>('.reveal');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reducedMotion) {
    revealElements.forEach((element) => element.classList.add('is-visible'));
  } else if ('IntersectionObserver' in window) {
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });

    revealElements.forEach((element) => revealObserver.observe(element));
  } else {
    revealElements.forEach((element) => element.classList.add('is-visible'));
  }

  // Aviso para lectores de pantalla en enlaces que abren una pestaña nueva (WCAG G201).
  const newTabHint = '(se abre en una pestaña nueva)';
  document.querySelectorAll<HTMLAnchorElement>('a[target="_blank"]').forEach((link) => {
    const label = link.getAttribute('aria-label');
    if (label) {
      if (!label.includes(newTabHint)) link.setAttribute('aria-label', `${label} ${newTabHint}`);
      return;
    }
    if (link.querySelector('[data-new-tab-hint]')) return;
    const hint = document.createElement('span');
    hint.className = 'sr-only';
    hint.dataset.newTabHint = '';
    hint.textContent = ` ${newTabHint}`;
    link.append(hint);
  });

  const header = document.querySelector<HTMLElement>('header');
  const headerSentinel = document.querySelector<HTMLElement>('[data-header-sentinel]');
  if (header && headerSentinel && 'IntersectionObserver' in window) {
    const headerObserver = new IntersectionObserver(([entry]) => {
      header.classList.toggle('is-scrolled', !entry.isIntersecting);
    });
    headerObserver.observe(headerSentinel);
  }
</script>